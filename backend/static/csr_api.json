{
  "swagger": "2.0",
  "info": {
    "title": "CSR API",
    "description": "API documentation for managing blog posts.",
    "version": "1.0.0"
  },
  "host": "127.0.0.1:5002",
  "basePath": "/",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "tags": [
    {
      "name": "Posts",
      "description": "Create, read, update, delete, and search blog posts"
    }
  ],
  "paths": {
    "/api/posts": {
      "get": {
        "tags": ["Posts"],
        "summary": "Returns all posts",
        "description": "Returns every post. Results can optionally be sorted by title or content.",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Field used to sort the posts",
            "required": false,
            "type": "string",
            "enum": ["title", "content"]
          },
          {
            "name": "direction",
            "in": "query",
            "description": "Sort direction. This defaults to asc.",
            "required": false,
            "type": "string",
            "default": "asc",
            "enum": ["asc", "desc"]
          }
        ],
        "responses": {
          "200": {
            "description": "Posts returned successfully",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/Post" }
            }
          },
          "400": {
            "description": "Invalid sort field or direction",
            "schema": { "$ref": "#/definitions/Message" }
          }
        }
      },
      "post": {
        "tags": ["Posts"],
        "summary": "Creates a new post",
        "parameters": [
          {
            "name": "post",
            "in": "body",
            "description": "The post to create",
            "required": true,
            "schema": { "$ref": "#/definitions/NewPost" }
          }
        ],
        "responses": {
          "201": {
            "description": "Post created successfully",
            "schema": { "$ref": "#/definitions/Post" }
          },
          "400": {
            "description": "Invalid request body or missing required fields",
            "schema": { "$ref": "#/definitions/Message" }
          }
        }
      }
    },
    "/api/posts/search": {
      "get": {
        "tags": ["Posts"],
        "summary": "Searches for posts",
        "description": "Returns posts whose title and content contain the supplied values. Searches are case-insensitive.",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "description": "Text that must appear in the post title",
            "required": false,
            "type": "string"
          },
          {
            "name": "content",
            "in": "query",
            "description": "Text that must appear in the post content",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching posts returned successfully",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/Post" }
            }
          }
        }
      }
    },
    "/api/posts/{post_id}": {
      "put": {
        "tags": ["Posts"],
        "summary": "Updates an existing post",
        "description": "Updates the title, content, or both fields of a post.",
        "parameters": [
          { "$ref": "#/parameters/PostId" },
          {
            "name": "post",
            "in": "body",
            "description": "The fields to update",
            "required": true,
            "schema": { "$ref": "#/definitions/UpdatePost" }
          }
        ],
        "responses": {
          "200": {
            "description": "Post updated successfully",
            "schema": { "$ref": "#/definitions/Post" }
          },
          "400": {
            "description": "The request body is not a JSON object",
            "schema": { "$ref": "#/definitions/Message" }
          },
          "404": {
            "description": "Post not found",
            "schema": { "$ref": "#/definitions/Message" }
          }
        }
      },
      "delete": {
        "tags": ["Posts"],
        "summary": "Deletes a post",
        "parameters": [
          { "$ref": "#/parameters/PostId" }
        ],
        "responses": {
          "200": {
            "description": "Post deleted successfully",
            "schema": { "$ref": "#/definitions/Message" }
          },
          "404": {
            "description": "Post not found",
            "schema": { "$ref": "#/definitions/Message" }
          }
        }
      }
    }
  },
  "parameters": {
    "PostId": {
      "name": "post_id",
      "in": "path",
      "description": "Numeric ID of the post",
      "required": true,
      "type": "integer",
      "format": "int32",
      "minimum": 1
    }
  },
  "definitions": {
    "Post": {
      "type": "object",
      "required": ["id", "title", "content"],
      "properties": {
        "id": { "type": "integer", "format": "int32", "example": 1 },
        "title": { "type": "string", "example": "First post" },
        "content": { "type": "string", "example": "This is the first post." }
      }
    },
    "NewPost": {
      "type": "object",
      "required": ["title", "content"],
      "properties": {
        "title": { "type": "string", "example": "My new post" },
        "content": { "type": "string", "example": "This is the post content." }
      }
    },
    "UpdatePost": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "example": "Updated title" },
        "content": { "type": "string", "example": "Updated post content." }
      }
    },
    "Message": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string", "example": "Operation completed successfully." }
      }
    }
  }
}
